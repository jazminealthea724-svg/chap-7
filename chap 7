    static double inchTocenti(double inch) {
        return inch * 2.54;
    }

    static double feetTocenti(double feet) {
        return feet * 30;
    }

    static double yardsTomet(double yards) {
        return yards * 0.91;
    }

    static double milesTokilo(double miles) {
        return miles * 1.6;
    }

    static double centiToinch(double centi) {
        return centi / 2.54;
    }

    static double centiTofeet(double centi) {
        return centi / 30;
    }

    static double metToyards(double met) {
        return met / 0.91;
    }

    static double kiloTomiles(double kilo) {
